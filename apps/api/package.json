{
  "name": "@devatlas/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "seed:technologies": "npm run build && node dist/features/technologies/seed.js",
    "seed:stack-guides": "npm run build && node dist/features/stack-guides/seed.js",
    "seed:build-guides": "npm run build && node dist/features/build-guides/seed.js",
    "monitor:releases": "npm run build && node dist/features/releases/monitor-command.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@devatlas/shared": "*",
    "@fastify/rate-limit": "^11.2.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.2",
    "jose": "^6.2.13",
    "mongoose": "^9.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "server-only": "^0.0.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
