# Copy to apps/api/.env and put a development MongoDB Atlas URI in MONGODB_URI.
# Atlas URI shape (replace placeholders; URL-encode special characters in credentials):
# mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>?retryWrites=true&w=majority
# No local MongoDB fallback is used when the URI is missing or Atlas is unavailable.
MONGODB_URI=
# Optional compatibility alias. If both URI variables are set, they must match.
DATABASE_URL=
PHASE15_MONGODB_TEST_URI=
PHASE2_MONGODB_TEST_URI=
HOST=127.0.0.1
PORT=4001
LOG_LEVEL=info
